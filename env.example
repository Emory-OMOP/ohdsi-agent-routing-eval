# Repo-root environment template — for the app (webapp + servers + eval harness).
# Copy to ".env" (git-ignored) and fill in real values. Placeholders below; do not
# commit real credentials. (Langfuse's OWN stack has a separate template: langfuse/env.example.)

# ═════════════════════════════════════════════════════════════════════════════
# SET THESE — the run_arxiv_matrix.sh runner reads these and derives the
# server-internal vars (bottom section) for you.
# ═════════════════════════════════════════════════════════════════════════════

# Evaluation database (see README "Data" for how to obtain/rebuild it).
DUCKDB_PATH=/absolute/path/to/synthea_omop_etl.duckdb

# Webapp auth (change before any non-local use).
BETA_PASSKEY=changeme
JWT_SECRET=changeme-jwt-secret

# Model providers — set only the ones you evaluate.
#   Smoke test needs only ANTHROPIC_API_KEY. Local Qwen needs only Ollama running.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Agent loop — the published evaluation used a maximum of 10 tool-use rounds.
MAX_TOOL_ROUNDS=10

# ── Langfuse (the full stack includes it) ────────────────────────────────────
# Bring up langfuse/ first (see langfuse/README.md), then paste the project keys
# you set there (LANGFUSE_INIT_PROJECT_PUBLIC_KEY / _SECRET_KEY) here.
# For a lean run WITHOUT Langfuse, set LANGFUSE_ENABLED=false and skip the keys.
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-REPLACE_ME
LANGFUSE_SECRET_KEY=sk-lf-REPLACE_ME
LANGFUSE_HOST=http://localhost:3000

# ═════════════════════════════════════════════════════════════════════════════
# MCP endpoints the webapp connects to (defaults match the runner's ports).
# ═════════════════════════════════════════════════════════════════════════════
MCP_OHDSI_VOCAB_URL=http://localhost:8001/mcp
MCP_CIRCE_COMPILER_URL=http://localhost:8002/mcp
MCP_OMCP_URL=http://localhost:8003/mcp
MCP_SIDECAR_URL=        # sidecar was NOT part of the evaluation — leave unset

# Path to the omcp server (vendored). Default resolves to servers/omcp.
OMCP_REPO=

# ═════════════════════════════════════════════════════════════════════════════
# SERVER-INTERNAL — run_arxiv_matrix.sh sets these per-process automatically.
# You only need them if you start the three MCP servers MANUALLY.
# ═════════════════════════════════════════════════════════════════════════════
# ohdsi-vocab (:8001) and circe-compiler (:8002):
#   OHDSI_DUCKDB_PATH=<same as DUCKDB_PATH>
#   OHDSI_VOCAB_SCHEMA=main_vocab
#   OHDSI_CDM_SCHEMA=main_cdm
#   MCP_TRANSPORT=streamable-http
#   MCP_PORT=8001            # 8002 for circe-compiler
#   PHENOTYPE_LIBRARY_DIR=<optional; defaults under servers/ohdsi-vocab/data>
# omcp (:8003):
#   DB_TYPE=duckdb
#   DB_PATH=<same as DUCKDB_PATH>
#   DB_READ_ONLY=true
#   CDM_SCHEMA=main_cdm
#   VOCAB_SCHEMA=main_vocab
#   ENABLE_LANGFUSE=false    # omcp's own tracing; the eval ran it off
#   MCP_TRANSPORT=streamable-http
#   MCP_HOST=localhost
#   MCP_PORT=8003
# omcp also supports a Databricks backend (DB_TYPE=databricks: DB_HOST, DB_HTTP_PATH,
# DB_TOKEN, DB_CATALOG, DB_SCHEMA, ...) — not used in this DuckDB evaluation.
