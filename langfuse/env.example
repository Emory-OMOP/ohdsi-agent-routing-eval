# Langfuse self-hosted stack — environment template.
# Copy to ".env" in THIS directory (langfuse/.env is git-ignored), fill in values,
# then: docker compose up -d
#
# Every value below is a placeholder. Generate the secrets locally — e.g.:
#   openssl rand -hex 32     # for ENCRYPTION_KEY (must be 64 hex chars)
#   openssl rand -base64 32  # for SALT and NEXTAUTH_SECRET
# and choose strong passwords for the datastores.

# ── Datastore credentials (used only inside the Langfuse stack) ──────────────
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=

# ── Langfuse app secrets ─────────────────────────────────────────────────────
ENCRYPTION_KEY=     # 64 hex chars: openssl rand -hex 32
SALT=               # openssl rand -base64 32
NEXTAUTH_SECRET=    # openssl rand -base64 32

# ── First-run bootstrap (org / project / login user) ─────────────────────────
LANGFUSE_INIT_ORG_ID=ohdsi-agent
LANGFUSE_INIT_ORG_NAME=OHDSI Agent
LANGFUSE_INIT_PROJECT_ID=routing-eval
LANGFUSE_INIT_PROJECT_NAME=Tool Routing Evaluation

# These two project keys are what the APP sends traces with. Put the SAME values
# into the repo-root .env as LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY.
# Use the Langfuse formats: public key starts "pk-lf-", secret key starts "sk-lf-".
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-REPLACE_ME
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-REPLACE_ME

# Initial login for the Langfuse UI at http://localhost:3000
LANGFUSE_INIT_USER_EMAIL=you@example.com
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=
